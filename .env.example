# Smart CRM - configuration. Copy to .env:  cp .env.example .env
# All values below are SAMPLE values for a local demo. Never commit the real .env.

# Database
# Docker: the "db" service creates DB_NAME and DB_USER automatically; DB_HOST is set to "db" by docker-compose.yml.
# Windows/XAMPP (README section 3): set DB_HOST, DB_USER, DB_PASSWORD to your local MySQL.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smartcrm_bt2_docker
DB_USER=smartcrm
DB_PASSWORD=smartcrm_local_db_password
DB_ROOT_PASSWORD=smartcrm_local_root_password

# Application
APP_ENV=development
APP_PORT=8000
WEB_PORT=8080

# Demo accounts created by database/seed_bt2.php (leave empty for a random password printed once)
DEMO_SALES_PASSWORD=Demo-Sales-2026
DEMO_MANAGER_PASSWORD=Demo-Manager-2026
