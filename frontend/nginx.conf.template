# Security (checklist item 6): log the path WITHOUT the query string, so search keywords
# such as customer names or phone numbers (/api/customers?search=...) are not written to logs.
log_format smartcrm_no_query '$remote_addr [$time_local] "$request_method $uri" $status $body_bytes_sent';

# This file is a TEMPLATE: the official nginx image replaces ${PORT} and ${API_UPSTREAM}
# with environment variables at start-up (defaults in frontend/Dockerfile: 80 and api:8000).
server {
    listen ${PORT};
    server_name _;
    server_tokens off;
    access_log /var/log/nginx/access.log smartcrm_no_query;

    root /usr/share/nginx/html;
    index index.html;

    # PHP API (docker-compose service "api"; another host:port on a hosting platform)
    location /api/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # React single-page application
    location / {
        try_files $uri $uri/ /index.html;
    }
}
