r=#20374A;fontFamily=DejaVu Sans;fontSize=19;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=12;spacingTop=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="1150" y="225" width="400" height="247" as="geometry" /></mxCell><mxCell id="txn" value="&lt;b&gt;QUY TẮC GỘP HỒ SƠ&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;Master ≠ Source, ACTIVE, cùng SĐT&lt;br&gt;BEGIN → SELECT ... FOR UPDATE&lt;br&gt;Ghi lịch sử → MERGED&lt;br&gt;COMMIT / ROLLBACK&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F7FD;strokeColor=#C6D8ED;fontColor=#20374A;fontFamily=DejaVu Sans;fontSize=19;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=12;spacingTop=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="1150" y="502" width="400" height="265" as="geometry" /></mxCell><mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#268E9D;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="ui" target="router"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#268E9D;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="router" target="ctrl"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#268E9D;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="ctrl" target="svc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#268E9D;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="svc" target="repo"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#268E9D;strokeWidth=3;endArro