<mxfile host="app.diagrams.net" modified="2026-10-31T00:00:00.000Z" agent="ChatGPT" version="24.7.17" type="device"><diagram id="bt2-architecture" name="Architecture BT2 - Implemented"><mxGraphModel dx="1600" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="930" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="ui" value="&lt;b&gt;01 GIAO DIỆN - React + Vite (5173)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;Login · Danh sách/Tra cứu · Tạo khách hàng · Hồ sơ trùng · Quản lý nhân viên&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF6F7;strokeColor=#CCDCE6;fontColor=#20374A;fontFamily=DejaVu Sans;fontSize=19;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=12;spacingTop=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="55" y="115" width="1050" height="102" as="geometry" /></mxCell><mxCell id="router" value="&lt;b&gt;02 HTTP API - PHP (8000)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;Vite proxy /api → src/public/index.php · JSON / HTTP · PHP Session&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CCDCE6;fontColor=#20374A;fontFamily=DejaVu Sans;fontSize=19;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=12;spacingTop=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="55" y="242" width="1050" height="85" as="geometry" /></mxCell><mxCell id="ctrl" value="&lt;b&gt;03 CONTROLLER&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px&quot;&gt;AuthController · CustomerController · MergeController · UserController&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8FC;strokeColor=#CCDCE6;fontColor=#20374A;fontFamily=DejaVu Sans;fontSize=19;align=left;verticalAlign=middle;spacingLeft=20;spacingRight=12;spacingTop=10;shadow=0;" vertex="1" parent="1"><mxGeometry x="55" y="353" width="1050" height="102" as="geometry" /></m